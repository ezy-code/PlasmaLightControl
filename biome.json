{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "formatter": {
        "enabled": false
    },
    "assist": {
        "enabled": true,
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "none",
            "complexity": {
                "useOptionalChain": "error"
            },
            "correctness": {
                "noUnusedImports": "error"
            },
            "style": {
                "useConst": "error",
                "useTemplate": "error"
            },
            "suspicious": {
                "noExplicitAny": "error",
                "noForIn": "error"
            }
        }
    }
}
